/* pages/ai/kitchen/recipe_analysis/recipe_analysis.wxss */
page {
  background: linear-gradient(180deg, #ff7a45 0%, #faad14 100%);
  min-height: 100vh;
  color: #fff;
}

.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}



.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  line-height: 1.2;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  line-height: 1.4;
}

.upload-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.upload-area {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 30rpx;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.upload-area::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    to bottom right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(45deg);
  animation: shine 3s infinite;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.upload-area:hover::before {
  opacity: 1;
}

.upload-area:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.98);
}

@keyframes shine {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.icon-camera {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.preview-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  animation: imageFadeIn 0.5s ease;
  transition: all 0.3s ease;
}

.image-item:hover {
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
}

@keyframes imageFadeIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.image-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 40rpx;
  border-bottom-left-radius: 10rpx;
  font-size: 24rpx;
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  animation: pulse 2s infinite;
}

.add-btn:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(1.05);
  border-color: rgba(255, 255, 255, 0.8);
}

.add-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.action-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.analyze-btn {
  background: #fff;
  color: #ff7a45;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  border: none;
  width: 100%;
  transition: all 0.3s ease;
}

.analyze-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.analyze-btn::after {
  border: none;
}

.analyze-btn[disabled] {
  background: rgba(255, 255, 255, 0.5) !important;
  color: rgba(0, 0, 0, 0.3) !important;
}

.result-section {
  width: 100%;
  animation: fadeIn 0.5s ease;
}

.result-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx;
  color: #333;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff7a45;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 10rpx;
  margin-bottom: 20rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #ff7a45;
  padding: 8rpx 16rpx;
  background: rgba(255, 122, 69, 0.1);
  border-radius: 8rpx;
  transition: all 0.3s ease;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.copy-btn:active {
  background: rgba(255, 122, 69, 0.2);
  transform: scale(0.95);
}

.result-content {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  letter-spacing: 0.5rpx;
  color: #555;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.save-section {
  margin-top: 30rpx;
  width: 100%;
}

.save-btn {
  background: #fff;
  color: #ff7a45;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  border: none;
  width: 100%;
  transition: all 0.3s ease;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: rgba(255, 255, 255, 0.5) !important;
  color: rgba(0, 0, 0, 0.3) !important;
}

.skeleton {
  animation: skeletonLoading 1.5s ease-in-out infinite;
}

.skeleton-title {
  width: 60%;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: skeletonLoading 1.5s ease-in-out infinite;
}

.skeleton-btn {
  width: 120rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: skeletonLoading 1.5s ease-in-out infinite;
}

.skeleton-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.skeleton-line {
  height: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: skeletonLoading 1.5s ease-in-out infinite;
}

.skeleton-line:nth-child(2) {
  width: 80%;
}

.skeleton-line:nth-child(3) {
  width: 60%;
}

@keyframes skeletonLoading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

@media screen and (max-width: 375px) {
  .title {
    font-size: 42rpx;
  }
  
  .subtitle {
    font-size: 24rpx;
  }
  
  .upload-area {
    height: 350rpx;
  }
  
  .icon-camera {
    font-size: 70rpx;
  }
  
  .analyze-btn {
    font-size: 28rpx;
    padding: 20rpx 0;
  }
  
  .save-btn {
    font-size: 28rpx;
    padding: 20rpx 0;
  }
  
  .result-title {
    font-size: 28rpx;
  }
  
  .copy-btn {
    font-size: 22rpx;
    padding: 6rpx 12rpx;
  }
  
  .result-content {
    font-size: 24rpx;
  }
  
  .skeleton-title {
    height: 32rpx;
  }
  
  .skeleton-btn {
    width: 100rpx;
    height: 32rpx;
  }
  
  .skeleton-line {
    height: 28rpx;
  }
}

@media screen and (min-width: 768px) {
  .container {
    max-width: 600rpx;
    margin-left: auto;
    margin-right: auto;
  }
  
  .upload-area {
    height: 450rpx;
  }
}
