
.post-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.author-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.author-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #f0f0f0;
}

.author-detail {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #fbbd08 0%, #f37b1d 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.follow-btn.followed {
  background: #e0e0e0;
  color: #666;
}

.follow-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.post-media {
  position: relative;
  background: #000;
}

.screen-swiper {
  width: 100%;
  height: 600rpx;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.page-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.post-text {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-text .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.post-text .content {
  font-size: 32rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

.comment-section {
  background: white;
  padding: 0 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.login-tip {
  font-size: 26rpx;
  color: #667eea;
  font-weight: normal;
}

.comment-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.comment-author {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.author-tag, .self-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.author-tag {
  background: #667eea;
  color: white;
}

.self-tag {
  background: #ff6b6b;
  color: white;
}

.comment-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: block;
}

.comment-info {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
}

.comment-delete {
  padding: 6rpx 12rpx;
  color: #999;
}

.like-count {
  font-size: 22rpx;
  color: #666;
}

.no-comment {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  margin-right: 20rpx;
}

.input-wrap .input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.action-group {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-icon {
  font-size: 44rpx;
}

.count {
  font-size: 22rpx;
  color: #666;
}

.comment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.comment-modal-content {
  width: 100%;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.comment-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.comment-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.comment-modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.comment-modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
}

.comment-count {
  font-size: 24rpx;
  color: #999;
}

.comment-submit-btn {
  background: linear-gradient(135deg, #fbbd08 0%, #f37b1d 100%);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}