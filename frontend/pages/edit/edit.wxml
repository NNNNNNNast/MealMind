<view class="cu-custom">
  <view class="cu-bar fixed custom-nav-gradient shadow" style="height: {{CustomBar}}px; padding-top: {{StatusBar}}px;">
    <view class="action" bindtap="goBack">
      <text class="cuIcon-back text-white"></text>
    </view>
    <view class="content text-white" style="padding-top: 19rpx;">编辑信息</view>
    <view class="action"></view>
  </view>
</view>

<view class="padding" style="margin-top: {{CustomBar}}px;">

  <view class="bg-white radius margin-bottom" bindtap="chooseAvatar">
    <view class="padding flex align-center">
      <view style="width: 100rpx; height: 100rpx; border-radius: 50%; overflow: hidden;">
        <image src="{{displayAvatar}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
      </view>
      <view class="flex flex-direction margin-left">
        <text class="text-black">头像</text>
        <text class="text-gray text-sm">点击更换头像</text>
      </view>
      <view class="flex-sub text-right">
        <text class="cuIcon-edit text-gray"></text>
      </view>
    </view>
  </view>

  <view class="cu-form-group margin-top">
    <view class="title">昵称</view>
    <input 
      placeholder="请输入昵称" 
      placeholder-class="text-gray" 
      value="{{nickname}}" 
      bindinput="onNicknameInput" 
      maxlength="20"
    />
  </view>

  <view class="padding flex flex-direction margin-top">
    <button 
      class="cu-btn bg-yellow light lg block" 
      bindtap="saveProfile" 
      disabled="{{saving}}"
    >
      <text class="cuIcon-check margin-right-xs"></text>
      {{saving ? '保存中...' : '保存修改'}}
    </button>
  </view>
</view>