page {
  --primary-color: #fbbd08;
  --primary-light: #fbbd08;
  --primary-dark: #fbbd08;
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg-primary: #f8f9fa;
  --bg-secondary: #ffffff;
  --border-color: #e8e8e8;
  --shadow-light: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-medium: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  --shadow-heavy: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  --transition-fast: 0.2s ease;
  --transition-medium: 0.3s ease;
  --transition-slow: 0.5s ease;
  background-color: var(--bg-primary);
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
  backdrop-filter: blur(10px);
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.06);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.nav-item {
  flex: 0 0 auto;
  padding: 0 60rpx;
  text-align: center;
  position: relative;
  transition: all var(--transition-medium);
}

.nav-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 400;
  transition: all var(--transition-medium);
  position: relative;
  z-index: 1;
}

.nav-item.active .nav-text {
  color: var(--primary-color);
  font-weight: 600;
  font-size: 36rpx;
}

.nav-indicator {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%) scale(0);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
  border-radius: 3rpx;
  transition: all var(--transition-medium);
  box-shadow: 0 2rpx 8rpx rgba(138, 201, 82, 0.4);
}

.nav-item.active .nav-indicator {
  transform: translateX(-50%) scale(1);
}

.nav-placeholder {
  width: 100%;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx;
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(138, 201, 82, 0.3);
  transition: all var(--transition-medium);
}

.empty-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(138, 201, 82, 0.4);
}

.post-list {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  animation: fadeIn 0.6s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.post-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-item {
  background: var(--bg-secondary);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-light);
  transition: all var(--transition-medium);
  animation: slideInUp 0.5s ease backwards;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.post-item:nth-child(1) { animation-delay: 0.1s; }
.post-item:nth-child(2) { animation-delay: 0.2s; }
.post-item:nth-child(3) { animation-delay: 0.3s; }
.post-item:nth-child(4) { animation-delay: 0.4s; }
.post-item:nth-child(5) { animation-delay: 0.5s; }

.post-item-hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.post-media {
  position: relative;
  width: 100%;
  min-height: 280rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
}

.post-image {
  width: 100%;
  display: block;
  transition: transform var(--transition-slow);
}

.post-item:active .post-image {
  transform: scale(1.05);
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.1), transparent);
  pointer-events: none;
}

.no-image {
  background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
}

.no-image .post-image {
  opacity: 0.3;
}

.post-content {
  padding: 20rpx;
}

.post-title {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 84rpx;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  overflow: hidden;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.author-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(138, 201, 82, 0.08);
  transition: all var(--transition-fast);
}

.like-info:active {
  transform: scale(0.9);
  background: rgba(138, 201, 82, 0.15);
}

.action-icon {
  font-size: 32rpx;
  color: var(--text-tertiary);
  transition: all var(--transition-fast);
}

.action-icon.liked {
  color: #fbbd08;
  animation: heartBeat 0.6s ease;
}

@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.2); }
  50% { transform: scale(0.9); }
  75% { transform: scale(1.1); }
}

.like-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 60rpx 40rpx;
}

.no-more-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, var(--border-color), transparent);
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 0 16rpx;
}

.float-publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(138, 201, 82, 0.4);
  z-index: 999;
  transition: all var(--transition-medium);
  animation: scaleIn 0.5s ease;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.float-publish-btn::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--primary-color);
  animation: ripple 2s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 0.3;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

.btn-icon {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
  position: relative;
  z-index: 1;
  transition: transform var(--transition-fast);
}

.float-publish-btn-hover {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(138, 201, 82, 0.5);
}

.float-publish-btn-hover .btn-icon {
  transform: rotate(90deg);
}

.btn-hide {
  transform: scale(0);
  opacity: 0;
}

@media screen and (min-width: 750rpx) {
  .post-list {
    gap: 24rpx;
    padding: 24rpx;
  }
  
  .post-column {
    gap: 24rpx;
  }
  
  .post-title {
    font-size: 30rpx;
  }
}

@media screen and (min-width: 1000rpx) {
  .post-list {
    max-width: 1200rpx;
    margin: 0 auto;
  }
}
