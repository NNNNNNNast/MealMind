<view class="cu-custom">
  <view class="cu-bar fixed custom-nav-gradient shadow" style="height: {{CustomBar}}px; padding-top: {{StatusBar}}px;">
    <view class="action"></view>
  </view>
</view>

<view class="nav-bar" style="padding-top: {{CustomBar}}px;">
  <view class="nav-content">
    <view class="nav-item {{currentTab === 'follow' ? 'active' : ''}}" bindtap="switchTab" data-tab="follow">
      <text class="nav-text">关注</text>
      <view class="nav-indicator"></view>
    </view>
    <view class="nav-item {{currentTab === 'discover' ? 'active' : ''}}" bindtap="switchTab" data-tab="discover">
      <text class="nav-text">发现</text>
      <view class="nav-indicator"></view>
    </view>
  </view>
</view>

<view style="height: {{marginTop}}px;"></view>

<view wx:if="{{loading && postList.length === 0}}" class="loading-container">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:elif="{{postList.length === 0 && !loading}}" class="empty-container">
  <view class="empty-icon">📝</view>
  <text class="empty-title">暂无帖子</text>
  <text class="empty-desc">去发布一条吧～</text>
  <view class="empty-btn" bindtap="goToPublish">立即发布</view>
</view>

<view class="post-list" wx:else="">
  <view class="post-column">
    <view class="post-item" wx:for="{{postList}}" wx:key="post_Id" wx:if="{{index % 2 === 0}}"
      bindtap="goToHostDetail" data-id="{{item.postId}}" hover-class="post-item-hover"> 
      
      <view class="post-media" wx:if="{{item.coverImage}}">
        <image 
          src="{{item.coverImage}}" 
          mode="aspectFill"
          binderror="onImageError"
          lazy-load="true"
          data-index="{{index}}"
          class="post-image"
        ></image>
        <view class="image-overlay"></view>
      </view>
      
      <view class="post-media no-image" wx:else>
        <image src="/img/tp.gif" mode="aspectFill" class="post-image"></image>
        <view class="image-overlay"></view>
      </view>
      
      <view class="post-content">
        <view class="post-title">{{item.title}}</view>
        
        <view class="post-footer">
          <view class="author-info" catchtap="goToAuthorHome" data-id="{{item.userId}}">
            <image src="{{item.avatar}}" 
              mode="aspectFill"
              binderror="onImageError"
              lazy-load="true"
              data-index="{{index}}"
              class="avatar"
            ></image>
            <text class="author-name">{{item.nickname}}</text>
          </view>
          <view class="like-info" catchtap="toggleLike" data-id="{{item.postId}}" data-index="{{index}}">
            <text class="cuIcon-like action-icon {{item.isLiked ? 'liked' : ''}}"></text>
            <text class="like-count">{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="post-column">
    <view class="post-item" wx:for="{{postList}}" wx:key="post_Id" wx:if="{{index % 2 === 1}}"
      bindtap="goToHostDetail" data-id="{{item.postId}}" hover-class="post-item-hover">
      
      <view class="post-media" wx:if="{{item.coverImage}}">
        <image 
          src="{{item.coverImage}}" 
          mode="aspectFill"
          binderror="onImageError"
          lazy-load="true"
          data-index="{{index}}"
          class="post-image"
        ></image>
        <view class="image-overlay"></view>
      </view>

      <view class="post-media no-image" wx:else>
        <image src="/img/tp.gif" mode="aspectFill" class="post-image"></image>
        <view class="image-overlay"></view>
      </view>
      
      <view class="post-content">
        <view class="post-title">{{item.title}}</view>
        
        <view class="post-footer">
          <view class="author-info" catchtap="goToAuthorHome" data-id="{{item.userId}}">
            <image src="{{item.avatar}}" 
              mode="aspectFill"
              binderror="onImageError"
              lazy-load="true"
              data-index="{{index}}"
              class="avatar"
            ></image>
            <text class="author-name">{{item.nickname}}</text>
          </view>
          <view class="like-info" catchtap="toggleLike" data-id="{{item.postId}}" data-index="{{index}}">
            <text class="cuIcon-like action-icon {{item.isLiked ? 'liked' : ''}}"></text>
            <text class="like-count">{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{loading && postList.length > 0}}" class="loading-more">
  <view class="loading-spinner-small"></view>
  <text>加载中...</text>
</view>

<view wx:elif="{{!hasMore && postList.length > 0}}" class="no-more">
  <view class="no-more-line"></view>
  <text class="no-more-text">已经到底了</text>
  <view class="no-more-line"></view>
</view>

<view class="float-publish-btn {{isScrolling ? 'btn-hide' : ''}}" bindtap="goToPublish" hover-class="float-publish-btn-hover">
  <view class="btn-icon">+</view>
</view>