  align-items: center;
}

.confirm-hint .cuIcon-info {
  margin-right: 8rpx;
}

.health-index-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.health-index-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #27ae60;
  line-height: 1.2;
}

.health-index-level {
  font-size: 20rpx;
  color: #7f8c8d;
  margin-top: 4rpx;
}


.exercise-list {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f2f7;
}

.exercise-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}

.exercise-item:active {
  transform: scale(0.98);
  background: #f0f2f7;
}

.exercise-item-info {
  flex: 1;
}

.exercise-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.exercise-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
}

.exercise-cal {
  font-size: 24rpx;
  color: #e74c3c;
  font-weight: 500;
}

.exercise-item-detail {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #95a5a6;
  margin-bottom: 8rpx;
}

.margin-left-sm {
  margin-left: 8rpx;
}

.exercise-desc {
  font-size: 22rpx;
  color: #7f8c8d;
  line-height: 1.5;
  padding: 8rpx 12rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
}
