  margin-right: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 16rpx;
  background: #fff;
  font-size: 28rpx;
  color: #666;
}

.confirm-btn {
  flex: 1;
  margin-left: 20rpx;
  padding: 20rpx;
  border: none;
  border-radius: 16rpx;
  background: #3d5a80;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}


.exercise-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}


.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8eaed;
