
page { background-color: #f7f9fc; }
.page-container { padding-bottom: 120rpx; }


.nav-header { padding: 40rpx 0 20rpx; text-align: center; }
.title-wrap { display: flex; align-items: center; justify-content: center; }
.title-text { font-size: 36rpx; font-weight: bold; margin-right: 20rpx; color: #2c3e50; }
.icon-s { font-size: 24rpx; color: #bdc3c7; padding: 0 10rpx; }
.title-date { font-size: 32rpx; font-weight: bold; padding: 0 10rpx; }


.card-shadow { background: #fff; margin: 0 20rpx 30rpx; border-radius: 48rpx; box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03); } 

.main-dashboard { padding: 40rpx 30rpx; position: relative; }


.dash-top { 
  display: flex; 
  justify-content: space-around; 
  align-items: center; 
  margin-bottom: 40rpx; 
  padding: 0 20rpx;
}

.stat-item { 
  flex: 1; 
  text-align: center; 
}

.stat-label { 
  font-size: 24rpx; 
  color: #bdc3c7; 
  display: block; 
  margin-bottom: 10rpx; 
}

.stat-val { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #2c3e50; 
}


.main-circle-wrapper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.main-circle {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex; 
  align-items: center; 
  justify-content: center;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.highlight-ctx .main-circle {
  transform: scale(1.1);
  z-index: 2001;
}


.circle-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 12rpx solid #f0f2f7;
  box-sizing: border-box;
  z-index: 1;
}


.circle-progress {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  padding: 12rpx;
  box-sizing: border-box;
  background: conic-gradient(#3d5a80 calc(var(--progress) * 1%), #f0f2f7 0%);
  mask: radial-gradient(transparent 50%, #000 50%);
  -webkit-mask: radial-gradient(transparent 50%, #000 50%);
  z-index: 2;
  transition: background 0.5s ease;
}

.circle-inner { 
  text-align: center; 
  z-index: 10;
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center; 
  justify-content: center;
  text-align: center; 
  z-index: 10;
  pointer-events: none;
}

.cu-custom .cu-bar {
  z-index: 100;
}


.main-dashboard {
  z-index: 1;
  position: relative;
}

.main-dashboard.highlight-ctx {
  z-index: 2001;
}


.van-popup {
  z-index: 2000 !important;
}

.big-num { 
  font-size: 48rpx; 
  font-weight: 800; 
  color: #2c3e50; 
  display: block; 
  line-height: 1; 
}

.small-label { 
  font-size: 24rpx; 
  color: #95a5a6; 
  margin-top: 10rpx; 
}


.edit-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: #f0f2f7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3d5a80;
  font-size: 32rpx;
  z-index: 10;
}

.edit-btn:active {
  background-color: #e2e4ea;
  transform: scale(0.9);
}


.nutri-grid { 
  display: flex; 
  justify-content: space-between; 
}

.nutri-item { 
  flex: 1; 
  padding: 0 10rpx; 
}

.n-head { 
  display: flex; 
  align-items: center; 
  margin-bottom: 15rpx; 
}

.n-dot { 
  width: 12rpx; 
  height: 12rpx; 
  border-radius: 50%; 
  margin-right: 8rpx; 
}

.n-dot.green { background: #4CAF50; }
.n-dot.orange { background: #FF9800; }
.n-dot.yellow { background: #FFC107; }

.n-name { 
  font-size: 22rpx; 
  color: #333; 
  font-weight: 500; 
}

.n-bar-bg { 
  height: 8rpx; 
  background: #f0f2f7; 
  border-radius: 10rpx; 
  overflow: hidden; 
}

.n-bar-fill { 
  height: 100%; 
  border-radius: 10rpx; 
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.n-bar-fill.green { background: #4CAF50; }
.n-bar-fill.orange { background: #FF9800; }
.n-bar-fill.yellow { background: #FFC107; }

.n-val { 
  font-size: 20rpx; 
  color: #bdc3c7; 
  margin-top: 12rpx; 
  text-align: center; 
}


.health-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}


.radio {
  display: flex;
  align-items: center;
}

.cu-btn.sm {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 36rpx;
  background: #f5f5f5;
}

.cu-btn.sm:active {
  background: #e5e5e5;
}


.tool-section {
  margin: 0 20rpx;
  margin-top: 20rpx;
}

.tool-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tool-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48%;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.tool-card:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.05);
}

.tool-card-full {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 30rpx 0;
  box-sizing: border-box;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.tool-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.meal-section {
  margin: 0 20rpx;
  margin-top: 20rpx;
}

.meal-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
  margin-bottom: 20rpx;
  padding: 30rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.meal-info {
  display: flex;
  align-items: center;
}

.meal-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f9fc;
  border-radius: 50%;
}

.meal-txt {
  flex: 1;
}

.m-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 4rpx;
}

.m-kcal {
  font-size: 24rpx;
  color: #bdc3c7;
}

.record-btn {
  border: 1rpx solid #eee;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.record-btn:active {
  background: #f5f5f5;
  transform: scale(0.98);
}


.food-list {
  padding-top: 20rpx;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
}

.food-dot {
  width: 12rpx;
  height: 12rpx;
  background: #3d5a80;
  border-radius: 50%;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.food-info {
  flex: 1;
}

.f-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
}

.f-sub {
  font-size: 22rpx;
  color: #bdc3c7;
  margin-top: 4rpx;
}


.van-slider__bar {
  height: 16rpx !important;
  border-radius: 8rpx !important;
}

.van-slider__button {
  width: 32rpx !important;
  height: 32rpx !important;
  margin-top: -8rpx !important;
  margin-left: -16rpx !important;
}


.meal-record-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.record-options {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 40rpx;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.option-item:active {
  transform: scale(0.95);
}

.option-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f7f9fc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.option-icon-text {
  font-size: 48rpx;
  color: #3d5a80;
}

.option-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}


.text-input-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.input-section {
  flex: 1;
  margin-top: 32rpx;
}

.input-section .food-input {
