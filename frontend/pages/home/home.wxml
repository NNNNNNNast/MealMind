<view class="cu-custom">
  <view class="cu-bar shadow shadow-lg fixed custom-nav-gradient"
    style="height: {{CustomBar}}px; display: flex; align-items: center; padding-top: {{StatusBar}}px;box-sizing: border-box;">
    <view style="flex: 1; margin-right: {{menuButtonInfo.width}}px; display: flex; align-items: center;">
      <view class="search-form round bg-gray light"
        style="display: flex; align-items: center; width: {{searchWidth}}px;height: {{searchHeight}}px; padding-bottom: 0%; padding-top: 0%;">
        <text class="cuIcon-search text-gray" style="font-size: 36rpx;"></text>
        <input type="text" placeholder="搜索关键词" placeholder-style="color: #999; font-size: 28rpx;" confirm-type="search"
          bindinput="onInput" bindconfirm="onSearch" value="{{keyword}}" focus="{{autoFocus}}"
          style="flex: 1; height: 100%; padding-left: 16rpx; font-size: 28rpx;" />
        <text class="cuIcon-close text-gray" wx:if="{{keyword}}" bindtap="clearInput"
          style="padding: 10rpx; font-size: 36rpx;"></text>
      </view>
    </view>
    <view class="action" style="width: {{menuButtonInfo.width}}px; opacity: 0;"></view>
  </view>
</view>

<view style="margin-top: {{CustomBar}}px; background: #f5f5f5; min-height: calc(100vh - {{CustomBar}}px);">

  <view style="padding: 20rpx 20rpx 0 20rpx;">
    <swiper indicator-dots="{{true}}" autoplay="{{true}}" interval="3000" circular="{{true}}"
      style="height: 320rpx; border-radius: 20rpx; overflow: hidden;">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image src="{{item.image}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
      </swiper-item>
    </swiper>
  </view>

  <view class="category-section">
  <view class="category-list">
    <view wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-category="{{item.name}}" class="category-item">
      <view class="category-icon">
        {{item.icon}}
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>
</view>

<view style="background: white; margin: 20rpx; padding: 20rpx; border-radius: 20rpx;">
  <view style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24rpx;">
    <text style="font-size: 32rpx; font-weight: bold;">推荐专题</text>
    <text style="font-size: 26rpx; color: #999;" bindtap="onMoreTap">更多</text>
  </view>
  
  <scroll-view 
    scroll-x 
    show-scrollbar="{{false}}" 
    style="white-space: nowrap; width: 100%;">
    <view style="display: inline-flex; padding-bottom: 10rpx;">
      <block wx:for="{{specials}}" wx:key="id">
        <view 
          bindtap="onSpecialTap" 
          data-special="{{item}}"
          data-id="{{item.id}}"
          style="width: 280rpx; margin-right: 20rpx; display: inline-block; vertical-align: top;">
          
          <image 
            src="{{item.image}}" 
            mode="aspectFill" 
            style="width: 280rpx; height: 180rpx; border-radius: 16rpx; background: #f5f5f5;">
          </image>
          
          <view style="padding: 12rpx 0;">
            <text style="font-size: 28rpx; font-weight: bold; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.title}}</text>
            <text style="font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{item.description}}</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>

  <view style="background: white; margin: 20rpx; padding: 20rpx; border-radius: 20rpx;">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx;">
      <view style="display: flex; align-items: baseline;">
        <text style="font-size: 32rpx; font-weight: bold;">为你推荐</text>
      </view>
      <view style="display: flex; align-items: center;">
        <view style="width: 32rpx; height: 32rpx; background: #67c23a; border-radius: 40rpx;"></view>
        <text style="font-size: 22rpx; color: #999; margin-left: 8rpx;">易</text>
        <view style="width: 32rpx; height: 32rpx; background: #e6a23c; border-radius: 40rpx; margin-left: 16rpx;">
        </view>
        <text style="font-size: 22rpx; color: #999; margin-left: 8rpx;">普</text>
        <view style="width: 32rpx; height: 32rpx; background: #f56c6c; border-radius: 40rpx; margin-left: 16rpx;">
        </view>
        <text style="font-size: 22rpx; color: #999; margin-left: 8rpx;">难</text>
      </view>
    </view>

    <view wx:for="{{recommendList}}" wx:key="recipeId" bindtap="onRecipeTap" data-id="{{item.recipeId}}"
      style="display: flex; margin-bottom: 24rpx; background: #fafafa; border-radius: 16rpx; overflow: hidden; position: relative;">
      <image src="{{item.imageUrl}}" mode="aspectFill" style="width: 200rpx; height: 200rpx; flex-shrink: 0;"></image>
      <view style="flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between;">
        <view>
          <view
            style="font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            {{item.title}}
          </view>
          <view style="display: flex; align-items: center;">
            <text class="cuIcon-time" style="font-size: 26rpx; color: #999;"></text>
            <text style="font-size: 24rpx; color: #999; margin-left: 6rpx;">{{item.cookTime}}</text>
          </view>
        </view>
        <view>
          <view wx:if="{{index < 6}}"
            style="display: inline-block; padding: 6rpx 16rpx; background: #e8f5e9; border-radius: 20rpx;">
            <text style="font-size: 22rpx; color: #67c23a;">{{item.recommendReason}}</text>
          </view>
          <view wx:else
            style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
            <text style="font-size: 24rpx; color: #999; line-height: 1.4;">{{item.description || '暂无描述'}}</text>
          </view>
        </view>
      </view>
      <view
        style="position: absolute; bottom: 0; right: 0; width: 0; height: 0; border-bottom: 60rpx solid {{item.difficultyLevel === 'easy' ? '#67c23a' : (item.difficultyLevel === 'medium' ? '#e6a23c' : '#f56c6c')}}; border-left: 60rpx solid transparent;">
      </view>
    </view>

    <view wx:if="{{loading}}" style="text-align: center; padding: 30rpx 0 20rpx 0;">
      <text class="cuIcon-loading" style="font-size: 40rpx; color: #999;"></text>
      <text style="font-size: 24rpx; color: #999; margin-left: 12rpx;">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && recommendList.length > 0}}" style="text-align: center; padding: 30rpx 0 20rpx 0;">
      <text style="font-size: 24rpx; color: #ccc;">— 已经到底了 —</text>
    </view>

    <view wx:if="{{!loading && recommendList.length === 0}}" style="text-align: center; padding: 60rpx 0 40rpx 0;">
      <text class="cuIcon-favorfill" style="font-size: 120rpx; color: #e0e0e0;"></text>
      <view style="font-size: 28rpx; color: #999; margin-top: 20rpx;">暂无推荐，先去浏览一些食谱吧~</view>
    </view>
  </view>



  <view wx:if="{{showBackTop}}" bindtap="scrollToTop"
    style="position: fixed; bottom: 120rpx; right: 30rpx; width: 80rpx; height: 80rpx; background: rgba(0,0,0,0.6); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
    <text class="cuIcon-top" style="font-size: 40rpx; color: white;"></text>
  </view>
</view>