.category-section {
  background: white;
  margin: 20rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.category-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  transition: all 0.3s ease;
  position: relative;
}

.category-item:active {
  transform: translateY(4rpx);
}

.category-icon {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 
    0 4rpx 8rpx rgba(255, 140, 0, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.12),
    0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.category-item:active .category-icon {
  box-shadow: 
    0 2rpx 4rpx rgba(255, 140, 0, 0.2),
    0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  transform: scale(0.95);
}

.category-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 140rpx;
  background: rgba(255, 140, 0, 0.05);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 140, 0, 0.1);
  z-index: 0;
  transition: all 0.3s ease;
}

.category-item:active::after {
  box-shadow: 0 4rpx 8rpx rgba(255, 140, 0, 0.15);
  transform: translateX(-50%) translateY(4rpx);
}

.category-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.6s ease;
}

.category-item:active .category-icon::before {
  left: 100%;
}

.category-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  padding: 0 10rpx;
  transition: all 0.3s ease;
  line-height: 1.2;
}

.category-item:active .category-name {
  color: #FF8C00;
}

@media (max-width: 375px) {
  .category-icon {
    width: 80rpx;
    height: 80rpx;
    font-size: 40rpx;
  }
  
  .category-name {
    font-size: 22rpx;
  }
  
  .category-item {
    padding: 16rpx 0;
  }
}

@media (min-width: 768px) {
  .category-icon {
    width: 100rpx;
    height: 100rpx;
    font-size: 48rpx;
  }
  
  .category-name {
    font-size: 26rpx;
  }
  
  .category-item {
    padding: 24rpx 0;
  }
}