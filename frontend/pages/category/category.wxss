.filter-section {
  background-color: var(--white);
  padding-bottom: 10rpx;
}

.filter-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.cuisine-scroll {
  white-space: nowrap;
  padding: 0 30rpx;
}

.cuisine-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 50rpx;
  background-color: #f5f5f5;
  color: var(--gray);
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.cuisine-item.active {
  background-color: var(--orange);
  color: var(--white);
}

.filter-tabs {
  display: flex;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--gray);
  position: relative;
  transition: all 0.3s ease;
  border-bottom: 4rpx solid transparent;
}

.filter-tab-item.active {
  color: var(--yellow);
  font-weight: bold;
  border-bottom-color: var(--yellow);
}

.filter-options {
  padding: 20rpx 30rpx;
}

.filter-options-scroll {
  white-space: nowrap;
}

.filter-option-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 50rpx;
  background-color: #f5f5f5;
  color: var(--gray);
  font-size: 26rpx;
  border: 1rpx solid transparent;
  transition: all 0.3s ease;
}

.filter-option-item.selected {
  background-color: #f37b1d; 
  color: #ffffff;
  border-color: #f37b1d;
}



.cu-list.menu-avatar > .cu-item {
  padding-right: 30rpx;
}

.loading-section {
  padding: 60rpx 0;
  text-align: center;
}