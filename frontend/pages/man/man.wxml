<!-- pages/man/man.wxml -->
<view class="cu-custom">
  <view class="cu-bar fixed custom-nav-gradient shadow" style="height: {{CustomBar}}px; padding-top: {{StatusBar}}px;">
    <view class="action" bindtap="goBack">
      <text class="cuIcon-back text-white"></text>
    </view>
    <view class="action"></view>
  </view>
</view>

<view style="height: {{CustomBar}}px;"></view>

<view class="author-page">
  <view class="author-info">
    <image class="avatar" src="{{authorInfo.avatar || 'https://img1.baidu.com/it/u=105216936,2956740654&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500'}}" mode="aspectFill"></image>
    <view class="info-text">
      <view class="nickname">{{authorInfo.nickname || '匿名用户'}}</view>
    </view>
  </view>

  <view class="author-stats">
    <view class="stat-item">
      <text class="stat-num">{{followCount || 0}}</text>
      <text class="stat-label">粉丝</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{followingCount || 0}}</text>
      <text class="stat-label">关注</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{likeCount || 0}}</text>
      <text class="stat-label">获赞</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{postCount || authorPosts.length || 0}}</text>
      <text class="stat-label">帖子</text>
    </view>
  </view>
  
  <view class="author-actions">
    <block wx:if="{{currentUser.userId !== authorInfo.id}}">
      <button class="follow-btn {{isFollowed ? 'followed' : ''}}" bindtap="toggleFollow">
        {{isFollowed ? '已关注' : '关注'}}
      </button>
    </block>
    <block wx:else>
      <button class="follow-btn" bindtap="editProfile">编辑资料</button>
    </block>
  </view>
  
  <view class="note-section">
    <view class="note-tab">
      <text class="tab-title">帖子</text>
    </view>

    <view wx:if="{{loading}}" class="loading-more">
      <text>加载中...</text>
    </view>
    
    <view wx:elif="{{authorPosts.length === 0}}" class="empty">
      <text class="empty-tip">TA还没有发布帖子哦~</text>
    </view>
    
    <view class="post-list" wx:else>
      <view class="post-column">
        <block wx:for="{{authorPosts}}" wx:key="postId" wx:if="{{index % 2 === 0}}">
          <view class="post-item" bindtap="goToPostDetail" data-id="{{item.postId}}">
            <view class="post-media">
              <image 
                src="{{item.coverImage || 'https://img1.baidu.com/it/u=105216936,2956740654&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500'}}" 
                mode="aspectFill" 
                binderror="onImageError"
                lazy-load="true"
              ></image>
            </view>
            <view class="post-title">{{item.title || '暂无标题'}}</view>
            <view class="post-footer">
              <view class="author-infos">
                <image 
                  src="{{item.avatar || 'https://img1.baidu.com/it/u=105216936,2956740654&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500'}}" 
                  mode="aspectFill"
                  class="avatars"
                ></image>
                <text class="author-name">{{item.nickname || '用户'}}</text>
              </view>
              <view class="like-info">
                <icon type="like" size="16" color="#ff6b6b"></icon>
                <text class="like-count">{{item.likeCount || 0}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
      
      <view class="post-column">
        <block wx:for="{{authorPosts}}" wx:key="postId" wx:if="{{index % 2 === 1}}">
          <view class="post-item" bindtap="goToPostDetail" data-id="{{item.postId}}">
            <view class="post-media">
              <image 
                src="{{item.coverImage || 'https://img1.baidu.com/it/u=105216936,2956740654&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500'}}" 
                mode="aspectFill" 
                binderror="onImageError"
                lazy-load="true"
              ></image>
            </view>
            <view class="post-title">{{item.title || '暂无标题'}}</view>
            <view class="post-footer">
              <view class="author-infos">
                <image 
                  src="{{item.avatar || 'https://img1.baidu.com/it/u=105216936,2956740654&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500'}}" 
                  mode="aspectFill"
                  class="avatars"
                ></image>
                <text class="author-name">{{item.nickname || '用户'}}</text>
              </view>
              <view class="like-info">
                <icon type="like" size="16" color="#ff6b6b"></icon>
                <text class="like-count">{{item.likeCount || 0}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{!hasMore && authorPosts.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
    
    <view wx:if="{{postLoading}}" class="loading-more">
      <text>加载更多...</text>
    </view>
  </view>
</view>