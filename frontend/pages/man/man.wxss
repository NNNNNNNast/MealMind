/* pages/author/author.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.author-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部信息栏 */
.author-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 返回按钮 */
.nav-left {
  height: 60rpx;
  width: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-left .yp {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border: #333 solid 8rpx;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(135deg);
}

/* 作者信息区 */
.author-info {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx 20rpx;
  background: #fff;
  gap: 20rpx;
}

/* 用户头像样式 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
  background-color: #f5f5f5;
}

.info-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.user-info {
  font-size: 26rpx;
  color: #999;
}

/* 数据统计区 */
.author-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮区 */
.author-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.follow-btn {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #ff2442;
  color: #fff;
  border: none;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  transition: all 0.2s ease;
}

.follow-btn.followed {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.follow-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 笔记列表区 */
.note-section {
  background-color: #f5f5f5;
  padding: 0;
  min-height: 60vh;
}

.note-tab {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
}

.tab-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  position: relative;
}

/* 帖子信息流 - 双列布局 */
.post-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 10rpx 20rpx 20rpx;
  gap: 20rpx;
}

.post-item {
  display: flex;
  flex-direction: column;
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.post-item:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 帖子封面容器 */
.post-media {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background-color: #f0f0f0;
}

.post-media image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 默认占位图 - 帖子图片样式 */
.post-media.no-image {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e0e0e0 0%, #cccccc 100%);
}

/* 帖子标题 */
.post-title {
  padding: 16rpx 16rpx 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 80rpx;
}

/* 帖子底部 */
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 16rpx 16rpx;
}

.author-infos {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  overflow: hidden;
}

/* 帖子中的用户头像 - 小尺寸 */
.avatars {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.author-name {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.like-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.like-info icon {
  margin-right: 2rpx;
}

.like-count {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 加载更多提示 */
.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 60rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* 空数据提示 */
.empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-tip {
  font-size: 28rpx;
  color: #bbb;
}

/* 修复空状态显示问题 */
.empty-note {
  min-height: 400rpx;
}

.post-list {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 10rpx 20rpx 20rpx;
  gap: 20rpx;
}

.post-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 确保 post-item 在列中占满宽度 */
.post-column .post-item {
  width: 100%;
}